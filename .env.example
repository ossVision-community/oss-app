# Copy this file to .env and edit the values, then rebuild (npm run build).
# Everything here is NEXT_PUBLIC_*, meaning it is baked into the pages at
# BUILD time and is visible to visitors — never put a password or a secret
# key in this file.

# ---------------------------------------------------------------------------
# "اكتشف رؤيتنا" button
# ---------------------------------------------------------------------------
# Link opened by the vision button on the home page. Change it whenever the
# PDF is replaced. If left empty the button falls back to the current file.
NEXT_PUBLIC_VISION_PDF_URL="https://firebasestorage.googleapis.com/v0/b/oss-project-2bab0.firebasestorage.app/o/ref-OSS-Vision.pdf?alt=media&token=d9d2a40b-486b-45e3-bfcb-2f68bcc142ad"

# ---------------------------------------------------------------------------
# "انضم إلينا" register button
# ---------------------------------------------------------------------------
# "true" shows the register button on the home page. Any other value (or
# leaving it out) hides the button and makes /join unreachable.
NEXT_PUBLIC_REGISTRATION_ENABLED="false"

# Where the register button sends people. Put your Google Form link here and
# it opens in a new tab. Leave it empty to use the site's own /join form
# instead — that one stores applications in MongoDB and needs MONGODB_URI.
NEXT_PUBLIC_REGISTER_URL=""

# ---------------------------------------------------------------------------
# Database (only needed for the built-in /join form and partner enquiries)
# ---------------------------------------------------------------------------
# Leave MONGODB_URI empty while no database is attached: the site builds and
# runs fine without it, and the forms answer "unavailable" instead of failing.
MONGODB_URI=""
